---
import Guide from '../components/Guide.vue';
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>Expedition 33 · Leveling guide</title><script is:inline>
  try {
    const theme = localStorage.getItem('expedition-33-theme');
    if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
  } catch (_) {}
</script></head>
<body><Guide client:load /></body></html>
